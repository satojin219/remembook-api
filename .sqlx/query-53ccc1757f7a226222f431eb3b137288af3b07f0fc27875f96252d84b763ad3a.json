{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE coins\n            SET used_amount = used_amount + $1\n            WHERE user_id = $2\n            AND created_at + INTERVAL '180 days' > NOW()\n            AND purchased_amount - used_amount >= $1\n            RETURNING \n                coin_id,\n                user_id,\n                session_id,\n                purchased_amount,\n                used_amount,\n                coin_type,\n                created_at,\n                updated_at\n            ",
