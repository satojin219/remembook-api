{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                coin_id,\n                user_id,\n                session_id,\n                purchased_amount,\n                used_amount,\n                coin_type,\n                created_at,\n                updated_at\n            FROM coins\n            WHERE user_id = $1\n            AND created_at + INTERVAL '180 days' > NOW()\n            AND purchased_amount > used_amount\n            ORDER BY created_at DESC\n            ",
